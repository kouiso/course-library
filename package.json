{
  "name": "course-library",
  "version": "0.1.0",
  "description": "Japanese private course delivery with Cloudflare Workers and R2",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typegen": "node scripts/wrangler.mjs types --include-runtime false",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/wrangler.mjs deploy --dry-run --outdir dist",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm run build && npm test",
    "lint": "node scripts/lint.mjs",
    "scan:public": "node scripts/public-scan.mjs"
  },
  "keywords": [],
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "miniflare": "5.20261019.2-beta",
    "typescript": "^7.0.2",
    "wrangler": "^4.152.0"
  },
  "private": true,
  "type": "module"
}
