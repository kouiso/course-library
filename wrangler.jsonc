{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "taskapp-course",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": { "APP_ORIGIN": "https://setup-required.invalid", "APP_MODE": "production" },
  "r2_buckets": [{ "binding": "MATERIALS", "bucket_name": "taskapp-course-private-setup-required" }],
  "ratelimits": [
    { "name": "LOGIN_IP_LIMIT", "namespace_id": "9127301", "simple": { "limit": 5, "period": 60 } },
    { "name": "LOGIN_TOTAL_LIMIT", "namespace_id": "9127302", "simple": { "limit": 60, "period": 60 } }
  ]
}
